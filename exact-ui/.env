# The job source the on-device core reads (ADR-0037): the stand-in in server.ts for test and verify.
# A real build leaves it unset and reads Remotive; .env.local (out of git) or the environment wins over this file.
REMOTIVE_URL=http://127.0.0.1:4417/remotive
# The other job sources: one stand-in each under this address (server.ts). A real build leaves it unset.
SOURCES_BASE_URL=http://127.0.0.1:4417/sources
