// JobPilot on Exact: the candidate's jobs and applications, read from the local daemon (ADR-0012).
// Two tabs, each its own stack: Jobs pushes a job's detail, Applications lists where each one stands.
// The candidate writes and sends their own application (ADR-0034): the detail's one action opens the
// posting in their own browser, and nothing here fills or submits a form.
use EmptyState from "exact:content"

routes nav
  tab jobs "/"
    job "/job/:id"
  tab applications "/applications"
    application "/application/:id"
  tab scouts "/scouts"
  tab profile "/profile"
    resumes "/resumes"
    activity "/activity"
    settings "/settings"

shape Job
  id: string
  title: string
  company: string
  location: string
  remote: string
  salary: string
  posted: string
  skills: string[]
  description: string
  url: string

shape Match
  jobId: string
  score: number
  rationale: string
  strengths: string[]
  gaps: string[]

shape Scout
  id: string
  name: string
  enabled: bool
  minScore: number
  ceiling: number
  lastRun: string

shape Me
  name: string
  email: string
  phone: string
  location: string

shape Resume
  id: string
  name: string
  updated: string

shape Run
  id: string
  title: string
  status: string
  started: string
  events: number

shape Model
  provider: string
  model: string
  address: string

shape Step
  id: string
  from: string
  to: string
  reason: string
  at: string

shape Application
  id: string
  applyUrl: string
  jobId: string
  title: string
  company: string
  state: string
  updated: string

fn matches(j: Job, q: string): bool = j.title.toLowerCase().includes(q.trim().toLowerCase()) or j.company.toLowerCase().includes(q.trim().toLowerCase())
fn blankJob(): Job = Job(id="", title="", company="", location="", remote="", salary="", posted="", skills=[], description="", url="")

component App
  state query = ""
  resource jobs = loadJobs() as shape Job[] else empty()
  resource applications = loadApplications() as shape Application[] else empty()
  derive selected = match stack(nav).filter(e => e.name == "job").at(-1) { case some(e) => e.params.id, case none => "" }
  resource fit = loadMatch(selected) when selected != "" as shape Match else empty()
  derive openApp = match stack(nav).filter(e => e.name == "application").at(-1) { case some(e) => e.params.id, case none => "" }
  resource steps = loadHistory(openApp) when openApp != "" as shape Step[] else empty()
  derive app = match first(applications.filter(a => a.id == openApp)) { case some(a) => a, case none => Application(id="", applyUrl="", jobId="", title="", company="", state="", updated="") }
  resource scouts = loadScouts() as shape Scout[] else empty()
  resource me = loadProfile() as shape Me else empty()
  resource resumes = loadResumes() as shape Resume[] else empty()
  resource runs = loadRuns() as shape Run[] else empty()
  resource model = loadModel() as shape Model else empty()
  action reloadModel
    refresh model
  action reloadResumes
    refresh resumes
  action reloadRuns
    refresh runs
  action reloadScouts
    refresh scouts
  action reloadProfile
    refresh me
  derive shown = jobs.filter(j => matches(j, query))
  derive opened = match first(jobs.filter(j => j.id == selected)) { case some(j) => j, case none => blankJob() }
  derive scoreText = fit.jobId == selected and fit.score >= 0 ? `${fit.score}% match` : "No match analysis yet"

  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  action search(v: string)
    query = v
  action reloadJobs
    refresh jobs
  action reloadApplications
    refresh applications

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
                display="flex" flex-direction="column"
                header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="8px 16px"
                  text (e.name == "jobs" ? "Jobs" : e.name == "applications" ? "Applications" : e.name == "application" ? app.title : e.name == "scouts" ? "Scouts" : e.name == "profile" ? "Profile" : e.name == "resumes" ? "Resumes" : e.name == "activity" ? "Activity" : e.name == "settings" ? "Settings" : opened.title)
                    role="heading" aria-level=(e.name == "job" or e.name == "application" or e.name == "resumes" or e.name == "activity" or e.name == "settings" ? 2 : 1) flex=1
                  if e.name == "jobs"
                    input type="search" value=query input=search placeholder="Search" aria-label="Search Jobs"
                      testId="search" width="100%"
                if e.name == "jobs"
                  if failed(jobs)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach JobPilot", message="Check that the daemon is running.")
                      button press=reloadJobs testId="retry-jobs"
                        text "Try Again"
                  else if jobs.length == 0 and not pending(jobs)
                    EmptyState(symbol="symbol:search", title="No Jobs Yet", message="Run a search in JobPilot and what it finds appears here.")
                  else if shown.length == 0 and not pending(jobs)
                    EmptyState(symbol="symbol:search", title=`No Results for “${query.trim()}”`, message="Check the spelling or try a new search.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for j in shown key=j.id
                          link href=path("job", j.id) testId=`job-${j.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text j.title
                              text `${j.company}${j.location == "" ? "" : " · " + j.location}` font="-exact-subheadline"
                                color="-exact-secondary-label" line-clamp=1
                            image "symbol:forward-chevron"
                else if e.name == "applications"
                  if failed(applications)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach JobPilot", message="Check that the daemon is running.")
                      button press=reloadApplications testId="retry-applications"
                        text "Try Again"
                  else if applications.length == 0 and not pending(applications)
                    EmptyState(symbol="symbol:document", title="No Applications", message="Start one from a job you want to apply for.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for a in applications key=a.id
                          link href=path("application", a.id) testId=`application-${a.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text a.title
                              text a.company font="-exact-subheadline" color="-exact-secondary-label"
                            column align-items="flex-end" gap=2
                              text a.state testId=`state-${a.id}`
                              text a.updated font="-exact-footnote" color="-exact-secondary-label"
                                font-variant-numeric="tabular-nums"
                            image "symbol:forward-chevron"
                else if e.name == "scouts"
                  if failed(scouts)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach JobPilot", message="Check that the daemon is running.")
                      button press=reloadScouts testId="retry-scouts"
                        text "Try Again"
                  else if scouts.length == 0 and not pending(scouts)
                    EmptyState(symbol="symbol:search", title="No Scouts", message="A Scout runs a saved search and creates applications for you to review.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for s in scouts key=s.id
                          row testId=`scout-${s.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text s.name
                              text `Minimum match ${s.minScore}% · up to ${s.ceiling} per run` font="-exact-subheadline" color="-exact-secondary-label"
                              if s.lastRun != ""
                                text `Last run ${s.lastRun}` font="-exact-footnote" color="-exact-secondary-label"
                            text (s.enabled ? "On" : "Off") testId=`scout-state-${s.id}`
                else if e.name == "profile"
                  if failed(me)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach JobPilot", message="Check that the daemon is running.")
                      button press=reloadProfile testId="retry-profile"
                        text "Try Again"
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        row
                          text "Name"
                          text me.name testId="profile-name"
                        if me.email != ""
                          row
                            text "Email"
                            text me.email testId="profile-email"
                        if me.phone != ""
                          row
                            text "Phone"
                            text me.phone
                        if me.location != ""
                          row
                            text "Location"
                            text me.location
                      section
                        link href=path("resumes") testId="open-resumes"
                          text "Resumes" flex=1
                          image "symbol:forward-chevron"
                        link href=path("activity") testId="open-activity"
                          text "Activity" flex=1
                          image "symbol:forward-chevron"
                        link href=path("settings") testId="open-settings"
                          text "Settings" flex=1
                          image "symbol:forward-chevron"
                else if e.name == "resumes"
                  if failed(resumes)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach JobPilot", message="Check that the daemon is running.")
                      button press=reloadResumes testId="retry-resumes"
                        text "Try Again"
                  else if resumes.length == 0 and not pending(resumes)
                    EmptyState(symbol="symbol:document", title="No Resumes", message="Add a resume in JobPilot and it appears here.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for r in resumes key=r.id
                          row testId=`resume-${r.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text r.name
                              text r.updated font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                else if e.name == "settings"
                  if failed(model)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach JobPilot", message="Check that the daemon is running.")
                      button press=reloadModel testId="retry-settings"
                        text "Try Again"
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        row
                          text "Provider"
                          text model.provider testId="setting-provider"
                        row
                          text "Model"
                          text model.model testId="setting-model"
                        if model.address != ""
                          row padding-top=10 padding-bottom=10
                            column flex=1 min-width=0 gap=2
                              text "Address"
                              text model.address font="-exact-subheadline" color="-exact-secondary-label"
                else if e.name == "activity"
                  if failed(runs)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach JobPilot", message="Check that the daemon is running.")
                      button press=reloadRuns testId="retry-activity"
                        text "Try Again"
                  else if runs.length == 0 and not pending(runs)
                    EmptyState(symbol="symbol:search", title="No Activity", message="What JobPilot does on your behalf is recorded here.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for r in runs key=r.id
                          row testId=`run-${r.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text r.title
                              text `${r.events} ${r.events == 1 ? "step" : "steps"}` font="-exact-subheadline" color="-exact-secondary-label"
                            column align-items="flex-end" gap=2
                              text r.status testId=`run-status-${r.id}`
                              text r.started font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                else if e.name == "application"
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        text "Company"
                        text app.company
                      row
                        text "Status"
                        text app.state testId="app-state"
                      row
                        text "Updated"
                        text app.updated font-variant-numeric="tabular-nums"
                    if app.applyUrl != ""
                      section
                        link href=app.applyUrl testId="app-apply"
                          text "Open the Application Page"
                    if steps.length > 0
                      section
                        for s in steps key=s.id
                          row testId=`step-${s.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text `${s.from == "" ? "" : s.from + " → "}${s.to}`
                              if s.reason != ""
                                text s.reason font="-exact-subheadline" color="-exact-secondary-label"
                            text s.at font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                else
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        text "Company"
                        text opened.company testId="detail-company"
                      if opened.location != ""
                        row
                          text "Location"
                          text opened.location
                      if opened.remote != ""
                        row
                          text "Work"
                          text opened.remote
                      if opened.salary != ""
                        row
                          text "Salary"
                          text opened.salary testId="detail-salary"
                      row
                        text "Posted"
                        text opened.posted font-variant-numeric="tabular-nums"
                    section
                      row
                        text "Fit"
                        text scoreText testId="detail-score"
                      if fit.jobId == selected and fit.rationale != ""
                        row padding-top=10 padding-bottom=10
                          text fit.rationale flex=1 min-width=0 testId="detail-rationale"
                    if opened.skills.length > 0
                      section
                        row
                          text "Skills"
                          text opened.skills.join(", ") testId="detail-skills"
                    section
                      row padding-top=10 padding-bottom=10
                        text opened.description flex=1 min-width=0 testId="detail-description"
                    section
                      link href=opened.url testId="detail-open"
                        text "Open the Posting"
      row role="tablist" testId="tabs"
        button role="tab" aria-controls="panel-jobs" aria-selected=(nav.tab == "jobs") press=pick("jobs")
          testId="tab-jobs" flex=1
          image "symbol:search"
          text "Jobs"
        button role="tab" aria-controls="panel-applications" aria-selected=(nav.tab == "applications")
          press=pick("applications") testId="tab-applications" flex=1
          image "symbol:document"
          text "Applications"
        button role="tab" aria-controls="panel-scouts" aria-selected=(nav.tab == "scouts") press=pick("scouts")
          testId="tab-scouts" flex=1
          image "symbol:search"
          text "Scouts"
        button role="tab" aria-controls="panel-profile" aria-selected=(nav.tab == "profile") press=pick("profile")
          testId="tab-profile" flex=1
          image "symbol:document"
          text "Profile"
