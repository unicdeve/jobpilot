// JobPilot on Exact: the candidate's jobs and applications, read from the local daemon (ADR-0012).
// Two tabs, each its own stack: Jobs pushes a job's detail, Applications lists where each one stands.
// The candidate writes and sends their own application (ADR-0034): the detail's one action opens the
// posting in their own browser, and nothing here fills or submits a form.
use EmptyState from "exact:content"
use Badge from "exact:content"

// Motion: rows rise into place as a list first shows, and a reply (a run's result, an error) settles in.
// Every animation is "none" under Reduce Motion.
keyframes rise
  from opacity=0 translate="0px 12px"
keyframes settle
  from opacity=0 scale=0.97

routes nav
  tab jobs "/"
    job "/job/:id"
  tab applications "/applications"
    application "/application/:id"
  tab discover "/discover"
  tab scouts "/scouts"
    scout "/scout/:id"
    scoutrun "/scout-run/:id"
  tab profile "/profile"
    profileedit "/profile-edit"
    resumes "/resumes"
    answers "/answers"
    companies "/companies"
    activity "/activity"
    settings "/settings"

shape Job
  id: string
  title: string
  company: string
  location: string
  remote: string
  salary: string
  posted: string
  skills: string[]
  description: string
  url: string

shape Match
  jobId: string
  score: number
  rationale: string
  strengths: string[]
  gaps: string[]

shape Time
  epochAtZero: number

shape Found
  id: string
  title: string
  company: string
  location: string
  url: string
  tracked: bool
  source: string

shape Discovery
  jobs: Found[]
  failed: string[]
  error: string

shape Scout
  id: string
  name: string
  enabled: bool
  minScore: number
  ceiling: number
  lastRun: string
  local: bool
  search: string

shape SavedSearch
  id: string
  name: string
  summary: string

shape ScoutForm
  name: string
  choice: string
  keywords: string
  minScore: string
  ceiling: string
  enabled: bool

shape ScoutRunRow
  id: string
  status: string
  started: string
  error: string
  summary: string

shape Trail
  id: string
  action: string
  status: string
  policy: string
  detail: string

shape RunReply
  ok: bool
  error: string
  message: string

shape Me
  name: string
  email: string
  phone: string
  location: string
  timeZone: string
  links: string[]
  authorizations: string[]
  skills: string
  experiences: string[]
  local: bool

shape ProfileFields
  firstName: string
  lastName: string
  email: string
  phone: string
  city: string
  region: string
  country: string
  timeZone: string
  links: string
  authorizations: string
  skills: string
  experiences: string

shape Resume
  id: string
  name: string
  updated: string
  detail: string
  local: bool

shape Watched
  id: string
  name: string
  provider: string
  url: string
  status: string
  roles: string
  problem: bool

shape JobCompany
  onBoard: bool
  watched: bool
  name: string

shape Suggested
  id: string
  name: string
  address: string
  detail: string

shape KeptAnswer
  id: string
  question: string
  answer: string
  updated: string

shape Run
  id: string
  title: string
  status: string
  started: string
  events: number
  local: bool

shape Notice
  text: string

shape ModelSettings
  provider: string
  baseUrl: string
  model: string
  keyLabel: string
  hasKey: bool
  notify: bool
  strong: string
  refresh: bool

shape Model
  provider: string
  model: string
  address: string

shape Step
  id: string
  from: string
  to: string
  reason: string
  at: string

shape Choice
  code: string
  label: string

shape Reply
  ok: bool
  error: string

shape Application
  local: bool
  next: Choice[]
  id: string
  applyUrl: string
  jobId: string
  title: string
  company: string
  state: string
  updated: string

shape Media
  prefersReducedMotion: bool

// A status reads as a word in a badge; the colour only repeats it. Good news is green, a closed door red,
// a step in progress the brand's teal, and anything settled or waiting the neutral grey.
fn stateTint(s: string): option<string> = s == "Offer" or s == "Interviewing" ? some("-exact-system-green") : s == "Rejected" ? some("-exact-system-red") : s == "Sent" or s == "Approved" or s == "Matched" ? some("AccentColor") : none
fn runTint(s: string): option<string> = s == "failed" ? some("-exact-system-red") : s == "running" ? some("AccentColor") : s == "completed" ? some("-exact-system-green") : none
fn capital(s: string): string = s == "" ? "" : s.slice(0, 1).toUpperCase() + s.slice(1)
// A row's entrance, staggered by its place in the list and capped, so a long list does not wait on its tail.
fn rise(still: bool, i: number): string = still ? "none" : `rise 360ms cubic-bezier(0.2, 0.7, 0.2, 1) ${i < 8 ? i * 45 : 360}ms both`
fn settle(still: bool): string = still ? "none" : "settle 260ms cubic-bezier(0.2, 0.7, 0.2, 1) both"

fn matches(j: Job, q: string): bool = j.title.toLowerCase().includes(q.trim().toLowerCase()) or j.company.toLowerCase().includes(q.trim().toLowerCase())
fn blankJob(): Job = Job(id="", title="", company="", location="", remote="", salary="", posted="", skills=[], description="", url="")

component App
  resource media = exactViewport() as shape Media
  derive still = media.prefersReducedMotion
  state query = ""
  resource jobs = loadJobs() as shape Job[] else empty()
  resource applications = loadApplications() as shape Application[] else empty()
  derive selected = match stack(nav).filter(e => e.name == "job").at(-1) { case some(e) => e.params.id, case none => "" }
  resource fit = loadMatch(selected) when selected != "" as shape Match else empty()
  derive openApp = match stack(nav).filter(e => e.name == "application").at(-1) { case some(e) => e.params.id, case none => "" }
  resource steps = loadHistory(openApp) when openApp != "" as shape Step[] else empty()
  derive app = match first(applications.filter(a => a.id == openApp)) { case some(a) => a, case none => Application(local=false, next=[], id="", applyUrl="", jobId="", title="", company="", state="", updated="") }
  resource scouts = loadScouts() as shape Scout[] else empty()
  resource savedSearches = loadSavedSearches() as shape SavedSearch[] else empty()
  resource scoutChoices = loadSearchChoices() as shape Choice[] else empty()
  derive openScout = match stack(nav).filter(e => e.name == "scout").at(-1) { case some(e) => e.params.id, case none => "" }
  derive openRun = match stack(nav).filter(e => e.name == "scoutrun").at(-1) { case some(e) => e.params.id, case none => "" }
  resource scoutForm = loadScoutForm(openScout) when openScout != "" as shape ScoutForm else empty()
  resource scoutRuns = loadScoutRuns(openScout) when openScout != "" and openScout != "new" as shape ScoutRunRow[] else empty()
  resource trail = loadRunTrail(openRun) when openRun != "" as shape Trail[] else empty()
  state draftFor = ""
  state dName = ""
  state dChoice = ""
  state dKeywords = ""
  state dMin = ""
  state dCeiling = ""
  state dEnabled = true
  state ranFor = ""
  derive fresh = draftFor != openScout
  derive fName = fresh ? scoutForm.name : dName
  derive fChoice = fresh ? scoutForm.choice : dChoice
  derive fKeywords = fresh ? scoutForm.keywords : dKeywords
  derive fMin = fresh ? scoutForm.minScore : dMin
  derive fCeiling = fresh ? scoutForm.ceiling : dCeiling
  derive fEnabled = fresh ? scoutForm.enabled : dEnabled
  mutation savedScout as shape Reply refreshes scouts, savedSearches, scoutChoices, scoutForm, scoutRuns then afterSave
  mutation ranScout as shape RunReply refreshes scouts, scoutRuns, applications, runs
  derive saveError = pending(savedScout) ? "" : match savedScout { case some(r) => r.error, case none => "" }
  derive ranHere = ranFor == openScout and not pending(ranScout)
  derive runOk = ranHere and match ranScout { case some(r) => r.ok, case none => false }
  derive runText = ranHere ? match ranScout { case some(r) => r.ok ? r.message : r.error, case none => "" } : ""
  action beginDraft
    if fresh
      dName = scoutForm.name
      dChoice = scoutForm.choice
      dKeywords = scoutForm.keywords
      dMin = scoutForm.minScore
      dCeiling = scoutForm.ceiling
      dEnabled = scoutForm.enabled
      draftFor = openScout
  action editName(v: string)
    beginDraft()
    dName = v
  action editChoice(v: string)
    beginDraft()
    dChoice = v
  action editKeywords(v: string)
    beginDraft()
    dKeywords = v
  action editMin(v: string)
    beginDraft()
    dMin = v
  action editCeiling(v: string)
    beginDraft()
    dCeiling = v
  action editEnabled(on: bool)
    beginDraft()
    dEnabled = on
  action submitScout
    if not pending(savedScout)
      send savedScout = saveScout(openScout, fName, fChoice, fKeywords, fMin, fCeiling, fEnabled, time.epochAtZero + performanceNow())
  action afterSave
    if match savedScout { case some(r) => r.ok, case none => false }
      draftFor = ""
      nav = back(nav)
  action runNow
    if not pending(ranScout)
      ranFor = openScout
      send ranScout = runScout(openScout, time.epochAtZero + performanceNow())
  resource me = loadProfile() as shape Me else empty()
  resource profileForm = loadProfileForm() as shape ProfileFields else empty()
  resource resumes = loadResumes() as shape Resume[] else empty()
  resource keptList = loadKept() as shape KeptAnswer[] else empty()
  resource watchedList = loadCompanies() as shape Watched[] else empty()
  resource suggestedList = loadSuggestions() as shape Suggested[] else empty()
  resource runs = loadRuns() as shape Run[] else empty()
  resource model = loadModel() as shape Model else empty()
  resource settings = loadSettings() as shape ModelSettings else empty()
  state pFor = ""
  state pFirst = ""
  state pLast = ""
  state pEmail = ""
  state pPhone = ""
  state pCity = ""
  state pRegion = ""
  state pCountry = ""
  state pZone = ""
  state pLinks = ""
  state pAuth = ""
  state pSkills = ""
  state pExp = ""
  derive pFresh = pFor == ""
  derive vFirst = pFresh ? profileForm.firstName : pFirst
  derive vLast = pFresh ? profileForm.lastName : pLast
  derive vEmail = pFresh ? profileForm.email : pEmail
  derive vPhone = pFresh ? profileForm.phone : pPhone
  derive vCity = pFresh ? profileForm.city : pCity
  derive vRegion = pFresh ? profileForm.region : pRegion
  derive vCountry = pFresh ? profileForm.country : pCountry
  derive vZone = pFresh ? profileForm.timeZone : pZone
  derive vLinks = pFresh ? profileForm.links : pLinks
  derive vAuth = pFresh ? profileForm.authorizations : pAuth
  derive vSkills = pFresh ? profileForm.skills : pSkills
  derive vExp = pFresh ? profileForm.experiences : pExp
  mutation savedProfile as shape Reply refreshes me, profileForm then afterProfile
  derive profileError = pending(savedProfile) ? "" : match savedProfile { case some(r) => r.error, case none => "" }
  action beginProfile
    if pFresh
      pFirst = profileForm.firstName
      pLast = profileForm.lastName
      pEmail = profileForm.email
      pPhone = profileForm.phone
      pCity = profileForm.city
      pRegion = profileForm.region
      pCountry = profileForm.country
      pZone = profileForm.timeZone
      pLinks = profileForm.links
      pAuth = profileForm.authorizations
      pSkills = profileForm.skills
      pExp = profileForm.experiences
      pFor = "me"
  action editFirst(v: string)
    beginProfile()
    pFirst = v
  action editLast(v: string)
    beginProfile()
    pLast = v
  action editEmail(v: string)
    beginProfile()
    pEmail = v
  action editPhone(v: string)
    beginProfile()
    pPhone = v
  action editCity(v: string)
    beginProfile()
    pCity = v
  action editRegion(v: string)
    beginProfile()
    pRegion = v
  action editCountry(v: string)
    beginProfile()
    pCountry = v
  action editZone(v: string)
    beginProfile()
    pZone = v
  action editLinks(v: string)
    beginProfile()
    pLinks = v
  action editAuth(v: string)
    beginProfile()
    pAuth = v
  action editSkills(v: string)
    beginProfile()
    pSkills = v
  action editExp(v: string)
    beginProfile()
    pExp = v
  action submitProfile
    if not pending(savedProfile)
      send savedProfile = saveProfile(vFirst, vLast, vEmail, vPhone, vCity, vRegion, vCountry, vZone, vLinks, vAuth, vSkills, vExp, time.epochAtZero + performanceNow())
  action afterProfile
    if match savedProfile { case some(r) => r.ok, case none => false }
      pFor = ""
      nav = back(nav)
  state rName = ""
  state rText = ""
  mutation addedResume as shape Reply refreshes resumes then afterResume
  mutation removedResume as shape Reply refreshes resumes
  mutation importedResume as shape Reply refreshes resumes
  derive importError = pending(importedResume) ? "" : match importedResume { case some(r) => r.error, case none => "" }
  action chooseResume
    showPicker("resume-file")
  action pickedResume(files: Picked[])
    if files.length > 0 and not pending(importedResume)
      send importedResume = importResume(match files.at(0) { case some(f) => f.path, case none => "" }, match files.at(0) { case some(f) => f.name, case none => "" }, time.epochAtZero + performanceNow())
  derive resumeError = pending(addedResume) ? "" : match addedResume { case some(r) => r.error, case none => "" }
  action editRName(v: string)
    rName = v
  action editRText(v: string)
    rText = v
  action submitResume
    if not pending(addedResume)
      send addedResume = addResume(rName.trim(), rText, time.epochAtZero + performanceNow())
  action afterResume
    if match addedResume { case some(r) => r.ok, case none => false }
      rName = ""
      rText = ""
  action dropResume(id: string)
    send removedResume = removeResume(id)
  state cAddress = ""
  mutation addedCompany as shape Reply refreshes watchedList, suggestedList then afterCompany
  mutation removedCompany as shape Reply refreshes watchedList, suggestedList
  derive companyError = pending(addedCompany) ? "" : match addedCompany { case some(r) => r.error, case none => "" }
  action editCAddress(v: string)
    cAddress = v
  action submitCompany
    if not pending(addedCompany)
      send addedCompany = watchCompany(cAddress, time.epochAtZero + performanceNow())
  action watchSuggested(address: string)
    if not pending(addedCompany)
      send addedCompany = watchCompany(address, time.epochAtZero + performanceNow())
  action afterCompany
    if match addedCompany { case some(r) => r.ok, case none => false }
      cAddress = ""
  action dropCompany(id: string)
    send removedCompany = unwatchCompany(id)
  state kQuestion = ""
  state kAnswer = ""
  mutation addedKept as shape Reply refreshes keptList then afterKept
  mutation removedKept as shape Reply refreshes keptList
  derive keptError = pending(addedKept) ? "" : match addedKept { case some(r) => r.error, case none => "" }
  action editKQuestion(v: string)
    kQuestion = v
  action editKAnswer(v: string)
    kAnswer = v
  action submitKept
    if not pending(addedKept)
      send addedKept = addKept(kQuestion.trim(), kAnswer.trim(), time.epochAtZero + performanceNow())
  action afterKept
    if match addedKept { case some(r) => r.ok, case none => false }
      kQuestion = ""
      kAnswer = ""
  action dropKept(id: string)
    send removedKept = removeKept(id)
  mutation cleared as shape Reply refreshes runs
  action askClear
    showModal("clear-activity")
  action clearNow
    send cleared = clearRuns()
  resource started = startup() with time.epochAtZero when time.epochAtZero > 0 as shape Reply else empty()
  state sFor = ""
  state sProvider = ""
  state sBase = ""
  state sModel = ""
  state sLabel = ""
  state sKey = ""
  state sNotify = true
  state sStrong = ""
  state sRefresh = true
  derive sFresh = sFor == ""
  derive wProvider = sFresh ? settings.provider : sProvider
  derive wBase = sFresh ? settings.baseUrl : sBase
  derive wModel = sFresh ? settings.model : sModel
  derive wLabel = sFresh ? settings.keyLabel : sLabel
  derive wKey = sFresh ? "" : sKey
  derive wNotify = sFresh ? settings.notify : sNotify
  derive wStrong = sFresh ? settings.strong : sStrong
  derive wRefresh = sFresh ? settings.refresh : sRefresh
  resource notice = loadNotice(wBase) as shape Notice else empty()
  mutation savedSettings as shape Reply refreshes settings then afterSettings
  derive settingsError = pending(savedSettings) ? "" : match savedSettings { case some(r) => r.error, case none => "" }
  action beginSettings
    if sFresh
      sProvider = settings.provider
      sBase = settings.baseUrl
      sModel = settings.model
      sLabel = settings.keyLabel
      sKey = ""
      sNotify = settings.notify
      sStrong = settings.strong
      sRefresh = settings.refresh
      sFor = "me"
  action editProvider(v: string)
    beginSettings()
    sProvider = v
  action editBase(v: string)
    beginSettings()
    sBase = v
  action editModel(v: string)
    beginSettings()
    sModel = v
  action editLabel(v: string)
    beginSettings()
    sLabel = v
  action editKey(v: string)
    beginSettings()
    sKey = v
  action editNotify(on: bool)
    beginSettings()
    sNotify = on
  action editStrong(v: string)
    beginSettings()
    sStrong = v
  action editRefresh(on: bool)
    beginSettings()
    sRefresh = on
  action submitSettings
    if not pending(savedSettings)
      send savedSettings = saveSettings(wProvider, wBase, wModel, wLabel, wKey, wNotify, wStrong, wRefresh)
  action afterSettings
    if match savedSettings { case some(r) => r.ok, case none => false }
      sFor = ""
      sKey = ""
  state finding = ""
  resource time = exactTime() as shape Time
  derive slot = floor(time.epochAtZero / 900000)
  resource found = discover(finding, slot) when time.epochAtZero > 0 as shape Discovery else empty()
  state reason = ""
  state linkDraft = ""
  mutation tracked as shape Reply refreshes found, applications
  mutation moved as shape Reply refreshes applications, steps then afterMove
  mutation linked as shape Reply refreshes applications then afterLink
  derive moveError = pending(moved) ? "" : match moved { case some(r) => r.error, case none => "" }
  derive linkError = pending(linked) ? "" : match linked { case some(r) => r.error, case none => "" }
  action track(id: string, title: string, company: string, url: string)
    send tracked = trackJob(id, title, company, url, time.epochAtZero + performanceNow())
  action advance(to: string)
    if not pending(moved)
      send moved = moveApplication(openApp, to, reason, time.epochAtZero + performanceNow())
  action afterMove
    if match moved { case some(r) => r.ok, case none => false }
      reason = ""
  action noteReason(v: string)
    reason = v
  action editLink(v: string)
    linkDraft = v
  action saveLink
    if not pending(linked)
      send linked = setApplyLink(openApp, linkDraft.trim(), time.epochAtZero + performanceNow())
  action afterLink
    if match linked { case some(r) => r.ok, case none => false }
      linkDraft = ""
  action find(v: string)
    finding = v
  action reloadFound
    refresh found
  action reloadModel
    refresh model
  action reloadResumes
    refresh resumes
  action reloadRuns
    refresh runs
  action reloadScouts
    refresh scouts
  action reloadProfile
    refresh me
  derive shown = jobs.filter(j => matches(j, query))
  derive opened = match first(jobs.filter(j => j.id == selected)) { case some(j) => j, case none => blankJob() }
  resource jobCompany = loadJobCompany(opened.url, opened.description) when selected != "" as shape JobCompany else empty()
  mutation watchedJob as shape Reply refreshes jobCompany, watchedList, suggestedList
  derive watchJobError = pending(watchedJob) ? "" : match watchedJob { case some(r) => r.error, case none => "" }
  action watchThisCompany
    if not pending(watchedJob)
      send watchedJob = watchJobCompany(opened.url, opened.description, time.epochAtZero + performanceNow())
  derive scoreText = fit.jobId == selected and fit.score >= 0 ? `${fit.score}% match` : "No match analysis yet"

  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  action back
    draftFor = ""
    pFor = ""
    sFor = ""
    nav = back(nav)
  action search(v: string)
    query = v
  action reloadJobs
    refresh jobs
  action reloadApplications
    refresh applications

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      display="flex" flex-direction="column" accent-color="AccentColor"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
                display="flex" flex-direction="column"
                header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="8px 16px"
                  text (e.name == "jobs" ? "Jobs" : e.name == "applications" ? "Applications" : e.name == "application" ? app.title : e.name == "discover" ? "Discover" : e.name == "scouts" ? "Scouts" : e.name == "scout" ? (openScout == "new" ? "New Scout" : "Scout") : e.name == "scoutrun" ? "Run" : e.name == "profile" ? "Profile" : e.name == "profileedit" ? "Edit Profile" : e.name == "resumes" ? "Resumes" : e.name == "answers" ? "Kept Answers" : e.name == "companies" ? "Watched Companies" : e.name == "activity" ? "Activity" : e.name == "settings" ? "Settings" : opened.title)
                    role="heading" aria-level=(e.name == "jobs" or e.name == "applications" or e.name == "discover" or e.name == "scouts" or e.name == "profile" ? 1 : 2) flex=1
                  if e.name == "profile"
                    button press=follow(path("profileedit")) testId="edit-profile"
                      text "Edit"
                  if e.name == "activity" and runs.filter(r => r.local).length > 0
                    button press=askClear destructive=true testId="clear-activity"
                      text "Clear"
                  if e.name == "jobs"
                    input type="search" value=query input=search placeholder="Search" aria-label="Search Jobs"
                      testId="search" width="100%"
                  if e.name == "scouts"
                    button press=follow(path("scout", "new")) testId="new-scout"
                      text "New"
                  if e.name == "discover"
                    input type="search" value=finding input=find placeholder="Search keywords" aria-label="Search the Job Board"
                      testId="find" width="100%"
                if e.name == "jobs"
                  if failed(jobs)
                    EmptyState(symbol="symbol:bag", title="Jobs from Your Computer", message="Jobs that JobPilot finds on your computer show here while it is running. To search from this phone, use Discover.")
                      button press=pick("discover") buttonStyle="filled" testId="jobs-discover"
                        text "Search in Discover"
                      button press=reloadJobs buttonStyle="tinted" testId="retry-jobs"
                        text "Try Again"
                  else if jobs.length == 0 and not pending(jobs)
                    EmptyState(symbol="symbol:bag", title="No Jobs Yet", message="Jobs that JobPilot finds on your computer show here. To search from this phone, use Discover.")
                      button press=pick("discover") buttonStyle="filled" testId="jobs-discover-empty"
                        text "Search in Discover"
                  else if shown.length == 0 and not pending(jobs)
                    EmptyState(symbol="symbol:search", title=`No Results for “${query.trim()}”`, message="Check the spelling or try a new search.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for j, i in shown key=j.id
                          link href=path("job", j.id) testId=`job-${j.id}` animation=rise(still, i)
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text j.title font="-exact-headline"
                              text [j.company, j.location].filter(x => x != "").join(" · ") font="-exact-subheadline"
                                color="-exact-secondary-label" line-clamp=1
                            image "symbol:forward-chevron"
                else if e.name == "applications"
                  if failed(applications)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach JobPilot", message="Check that the daemon is running.")
                      button press=reloadApplications buttonStyle="tinted" testId="retry-applications"
                        text "Try Again"
                  else if applications.length == 0 and not pending(applications)
                    EmptyState(symbol="symbol:document", title="No Applications", message="Track a job from Discover, or let a Scout find some for you.")
                      button press=pick("discover") buttonStyle="filled" testId="applications-discover"
                        text "Find a Job"
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for a, i in applications key=a.id
                          link href=path("application", a.id) testId=`application-${a.id}` display="flex" flex-wrap="wrap" align-items="center"
                            animation=rise(still, i)
                            column flex="1 1 12rem" min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text a.title font="-exact-headline"
                              text a.company font="-exact-subheadline" color="-exact-secondary-label"
                            column align-items="flex-end" gap=4
                              column testId=`state-${a.id}`
                                Badge(label=a.state, tint=stateTint(a.state))
                              text a.updated font="-exact-footnote" color="-exact-secondary-label"
                                font-variant-numeric="tabular-nums"
                            image "symbol:forward-chevron"
                else if e.name == "discover"
                  if failed(found)
                    EmptyState(symbol="symbol:alert", title="Can’t Reach the Job Board", message="Check your connection.")
                      button press=reloadFound buttonStyle="tinted" testId="retry-found"
                        text "Try Again"
                  else if finding.trim() == ""
                    EmptyState(symbol="symbol:search", title="Search the Job Board", message="Type a role or a keyword to search every job source at once.")
                  else if found.error != ""
                    EmptyState(symbol="symbol:alert", title="Nothing to Show", message=found.error)
                      button press=reloadFound buttonStyle="tinted" testId="retry-found"
                        text "Try Again"
                  else if found.jobs.length == 0 and not pending(found)
                    EmptyState(symbol="symbol:search", title="No Jobs Found", message=found.failed.length > 0 ? `${found.failed.join(", ")} did not answer.` : "Try other keywords.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      if found.failed.length > 0
                        section
                          row padding-top=10 padding-bottom=10
                            text `${found.failed.join(", ")} did not answer, so their jobs are missing.` flex=1 min-width=0
                              font="-exact-subheadline" color="-exact-secondary-label" testId="source-notice"
                      section
                        for f, i in found.jobs key=f.id
                          row display="flex" flex-wrap="wrap" align-items="center" gap=8 animation=rise(still, i)
                            link href=f.url testId=`found-${f.id}` flex="1 1 12rem" min-width=0
                              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                text f.title font="-exact-headline"
                                text [f.company, f.location].filter(x => x != "").join(" · ") font="-exact-subheadline"
                                  color="-exact-secondary-label"
                                text `via ${f.source}` font="-exact-footnote" color="-exact-secondary-label" testId=`found-source-${f.id}`
                            if f.tracked
                              column testId=`tracked-${f.id}` animation=settle(still)
                                Badge(label="Tracked", tint=some("AccentColor"))
                            else
                              button press=track(f.id, f.title, f.company, f.url) buttonStyle="tinted" testId=`track-${f.id}`
                                text "Track"
                else if e.name == "scouts"
                  if failed(scouts)
                    EmptyState(symbol="symbol:alert", title="Can’t Load Scouts", message="Something went wrong reading them.")
                      button press=reloadScouts buttonStyle="tinted" testId="retry-scouts"
                        text "Try Again"
                  else if scouts.length == 0 and savedSearches.length == 0 and not pending(scouts)
                    EmptyState(symbol="symbol:radio", title="No Scouts", message="A Scout runs a saved search and creates applications for you to review.")
                      button press=follow(path("scout", "new")) buttonStyle="filled" testId="scouts-new"
                        text "New Scout"
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      if scouts.length > 0
                        section
                          for s, i in scouts key=s.id
                            if s.local
                              link href=path("scout", s.id) testId=`scout-${s.id}` animation=rise(still, i)
                                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                  text s.name font="-exact-headline"
                                  text s.search font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1
                                  text `Minimum match ${s.minScore}% · up to ${s.ceiling} per run` font="-exact-subheadline" color="-exact-secondary-label"
                                  if s.lastRun != ""
                                    text `Last run ${s.lastRun}` font="-exact-footnote" color="-exact-secondary-label"
                                column testId=`scout-state-${s.id}`
                                  Badge(label=(s.enabled ? "On" : "Off"), tint=(s.enabled ? some("AccentColor") : none))
                                image "symbol:forward-chevron"
                            else
                              row testId=`scout-${s.id}` animation=rise(still, i)
                                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                  text s.name font="-exact-headline"
                                  text `Minimum match ${s.minScore}% · up to ${s.ceiling} per run` font="-exact-subheadline" color="-exact-secondary-label"
                                  if s.lastRun != ""
                                    text `Last run ${s.lastRun}` font="-exact-footnote" color="-exact-secondary-label"
                                column testId=`scout-state-${s.id}`
                                  Badge(label=(s.enabled ? "On" : "Off"), tint=(s.enabled ? some("AccentColor") : none))
                      if savedSearches.length > 0
                        section
                          header
                            text "Saved Searches"
                          for q in savedSearches key=q.id
                            row testId=`search-${q.id}`
                              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                text q.name
                                text q.summary font="-exact-subheadline" color="-exact-secondary-label"
                else if e.name == "scout"
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row padding-top=10 padding-bottom=10
                        input value=fName input=editName submit=submitScout placeholder="Name" aria-label="Scout name"
                          autocapitalize="words" testId="scout-name" flex=1 min-width=0
                      row
                        text "Search" flex=1
                        select value=fChoice change=editChoice aria-label="Search" testId="scout-choice"
                          for c in scoutChoices key=c.code
                            option c.label value=c.code
                      if fChoice == ""
                        row padding-top=10 padding-bottom=10
                          input value=fKeywords input=editKeywords submit=submitScout placeholder="Keywords, such as golang" aria-label="Keywords"
                            testId="scout-keywords" flex=1 min-width=0
                      row
                        text "Minimum match" flex=1
                        input type="number" value=fMin input=editMin min=0 max=100 step=5 aria-label="Minimum match" testId="scout-min"
                      row
                        text "Most per run" flex=1
                        input type="number" value=fCeiling input=editCeiling min=1 max=50 step=1 aria-label="Most applications per run" testId="scout-ceiling"
                      row
                        text "On" flex=1
                        input type="checkbox" switch checked=fEnabled change=editEnabled aria-label="Scout on" testId="scout-enabled"
                      button press=submitScout disabled=(pending(savedScout)) testId="scout-save"
                        text "Save"
                      if saveError != ""
                        row padding-top=10 padding-bottom=10 animation=settle(still)
                          text saveError color="-exact-system-red" flex=1 min-width=0 testId="scout-error"
                    if openScout != "new"
                      section
                        button press=runNow disabled=(pending(ranScout)) testId="scout-run"
                          text (pending(ranScout) ? "Running…" : "Run Now")
                        if runText != ""
                          row padding-top=10 padding-bottom=10 animation=settle(still)
                            text runText color=(runOk ? "-exact-label" : "-exact-system-red") flex=1 min-width=0 testId="scout-run-result"
                      if scoutRuns.length > 0
                        section
                          header
                            text "Runs"
                          for r, i in scoutRuns key=r.id
                            link href=path("scoutrun", r.id) testId=`scout-run-${r.id}` animation=rise(still, i)
                              column flex=1 min-width=0 gap=4 padding-top=4 padding-bottom=4 align-items="flex-start"
                                column testId=`scout-run-status-${r.id}`
                                  Badge(label=capital(r.status), tint=runTint(r.status))
                                text r.summary font="-exact-subheadline" color="-exact-secondary-label"
                                if r.error != ""
                                  text r.error font="-exact-footnote" color="-exact-system-red"
                              text r.started font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                              image "symbol:forward-chevron"
                else if e.name == "scoutrun"
                  if trail.length == 0 and not pending(trail)
                    EmptyState(symbol="symbol:search", title="No Steps", message="This run left no steps.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for t in trail key=t.id
                          row testId=`trail-${t.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text `${t.action}${t.policy == "" ? "" : " · " + t.policy}`
                              if t.detail != ""
                                text t.detail font="-exact-subheadline" color="-exact-secondary-label"
                            text t.status font="-exact-footnote" color="-exact-secondary-label"
                else if e.name == "profile"
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      if me.name == "" and me.email == ""
                        row padding-top=10 padding-bottom=10
                          text "Nothing here yet. Tap Edit to add your details; only what you enter is kept, on this device." flex=1 min-width=0
                            color="-exact-secondary-label" testId="profile-empty"
                      else
                        row
                          text "Name"
                          text me.name testId="profile-name"
                        if me.email != ""
                          row
                            text "Email"
                            text me.email testId="profile-email"
                        if me.phone != ""
                          row
                            text "Phone"
                            text me.phone
                        if me.location != ""
                          row
                            text "Location"
                            text me.location
                        if me.timeZone != ""
                          row
                            text "Time zone"
                            text me.timeZone
                    if me.skills != ""
                      section
                        header
                          text "Skills"
                        row padding-top=10 padding-bottom=10
                          text me.skills flex=1 min-width=0 testId="profile-skills"
                    if me.experiences.length > 0
                      section
                        header
                          text "Experience"
                        for x in me.experiences key=x
                          row padding-top=10 padding-bottom=10
                            text x flex=1 min-width=0
                    if me.authorizations.length > 0
                      section
                        header
                          text "Work Authorization"
                        for x in me.authorizations key=x
                          row
                            text x flex=1 min-width=0
                    if me.links.length > 0
                      section
                        header
                          text "Links"
                        for x in me.links key=x
                          row padding-top=10 padding-bottom=10
                            text x flex=1 min-width=0
                    section
                      link href=path("resumes") testId="open-resumes"
                        text "Resumes" flex=1
                        image "symbol:forward-chevron"
                      link href=path("answers") testId="open-answers"
                        text "Kept Answers" flex=1
                        image "symbol:forward-chevron"
                      link href=path("companies") testId="open-companies"
                        text "Watched Companies" flex=1
                        image "symbol:forward-chevron"
                      link href=path("activity") testId="open-activity"
                        text "Activity" flex=1
                        image "symbol:forward-chevron"
                      link href=path("settings") testId="open-settings"
                        text "Settings" flex=1
                        image "symbol:forward-chevron"
                else if e.name == "profileedit"
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      header
                        text "You"
                      row padding-top=10 padding-bottom=10
                        input value=vFirst input=editFirst placeholder="First name" aria-label="First name" autocapitalize="words" testId="p-first" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        input value=vLast input=editLast placeholder="Last name" aria-label="Last name" autocapitalize="words" testId="p-last" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        input type="email" value=vEmail input=editEmail placeholder="Email" aria-label="Email" testId="p-email" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        input type="tel" value=vPhone input=editPhone placeholder="Phone" aria-label="Phone" testId="p-phone" flex=1 min-width=0
                    section
                      header
                        text "Where You Are"
                      row padding-top=10 padding-bottom=10
                        input value=vCity input=editCity placeholder="City" aria-label="City" autocapitalize="words" testId="p-city" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        input value=vRegion input=editRegion placeholder="Region" aria-label="Region" autocapitalize="words" testId="p-region" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        input value=vCountry input=editCountry placeholder="Country" aria-label="Country" autocapitalize="words" testId="p-country" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        input value=vZone input=editZone placeholder="Time zone, such as Africa/Lagos" aria-label="Time zone" autocapitalize="none" testId="p-zone" flex=1 min-width=0
                    section
                      header
                        text "Skills"
                      row padding-top=10 padding-bottom=10
                        textarea value=vSkills input=editSkills rows=3 placeholder="Go: 6, SQLite" aria-label="Skills, with years after a colon" testId="p-skills" flex=1 min-width=0
                      footer
                        text "Separate with commas or new lines. Years are optional."
                    section
                      header
                        text "Experience"
                      row padding-top=10 padding-bottom=10
                        textarea value=vExp input=editExp rows=4 placeholder="Title | Company | 2022-07 | | What you did" aria-label="Experience, one role per line" testId="p-exp" flex=1 min-width=0
                      footer
                        text "One role per line: title | company | start | end | what you did. Leave the end empty for a current role."
                    section
                      header
                        text "Work Authorization"
                      row padding-top=10 padding-bottom=10
                        textarea value=vAuth input=editAuth rows=2 placeholder="Nigeria: authorized" aria-label="Work authorization, one country per line" testId="p-auth" flex=1 min-width=0
                      footer
                        text "One country per line: authorized, or needs sponsorship."
                    section
                      header
                        text "Links"
                      row padding-top=10 padding-bottom=10
                        textarea value=vLinks input=editLinks rows=3 placeholder="github https://github.com/you" aria-label="Links, one per line" testId="p-links" flex=1 min-width=0
                      footer
                        text "One per line: linkedin, github, portfolio, website, twitter or other, then the address."
                    section
                      button press=submitProfile disabled=(pending(savedProfile)) testId="profile-save"
                        text "Save"
                      if profileError != ""
                        row padding-top=10 padding-bottom=10 animation=settle(still)
                          text profileError color="-exact-system-red" flex=1 min-width=0 testId="profile-error"
                else if e.name == "resumes"
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      header
                        text "Add a Resume"
                      row padding-top=10 padding-bottom=10
                        input value=rName input=editRName placeholder="Name" aria-label="Resume name" autocapitalize="words" testId="resume-name" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        textarea value=rText input=editRText rows=6 placeholder="Paste or type your resume" aria-label="Resume text" testId="resume-text" flex=1 min-width=0
                      button press=submitResume disabled=(pending(addedResume)) testId="resume-add"
                        text "Add Resume"
                      row padding-top=10 padding-bottom=10
                        button press=chooseResume buttonStyle="tinted" disabled=(pending(importedResume)) testId="resume-import"
                          text (pending(importedResume) ? "Reading…" : "Import a File")
                        input type="file" id="resume-file" testId="resume-file" change=pickedResume aria-label="Import a resume file" display="none"
                      if importError != ""
                        row padding-top=10 padding-bottom=10 animation=settle(still)
                          text importError color="-exact-system-red" flex=1 min-width=0 testId="resume-import-error"
                      if resumeError != ""
                        row padding-top=10 padding-bottom=10 animation=settle(still)
                          text resumeError color="-exact-system-red" flex=1 min-width=0 testId="resume-error"
                      footer
                        text "Resumes are kept as text or Markdown that you paste or type, or read from a PDF, Word, text or Markdown file on this device. A scanned or protected PDF cannot be read: paste its text instead." testId="resume-note"
                    if resumes.length > 0
                      section
                        header
                          text "Your Resumes"
                        for r, i in resumes key=r.id
                          row delete=dropResume(r.id) disabled=(not r.local) testId=`resume-${r.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text r.name testId=`resume-title-${i}`
                              if r.detail != ""
                                text r.detail font="-exact-footnote" color="-exact-secondary-label"
                            text r.updated font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                else if e.name == "companies"
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      header
                        text "Watch a Company"
                      row padding-top=10 padding-bottom=10
                        input type="url" value=cAddress input=editCAddress placeholder="Hiring page address" aria-label="Hiring page address" autocapitalize="none" testId="company-address" flex=1 min-width=0
                      button press=submitCompany disabled=(pending(addedCompany)) testId="company-add"
                        text "Watch Company"
                      if companyError != ""
                        row padding-top=10 padding-bottom=10 animation=settle(still)
                          text companyError color="-exact-system-red" flex=1 min-width=0 testId="company-error"
                      footer
                        text "Paste a Greenhouse, Lever, Ashby, Workable or SmartRecruiters hiring page, or any posting on it. Its openings join Discover and your scouts as Company pages."
                    if watchedList.length > 0
                      section
                        header
                          text "Watching"
                        for c in watchedList key=c.id
                          row delete=dropCompany(c.id) testId=`company-${c.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text c.name testId=`company-name-${c.id}`
                              text c.provider font="-exact-footnote" color="-exact-secondary-label"
                              text c.status font="-exact-footnote" color=(c.problem ? "-exact-system-red" : "-exact-secondary-label")
                            if c.roles != ""
                              text c.roles font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                    if suggestedList.length > 0
                      section
                        header
                          text "Suggestions"
                        for s in suggestedList key=s.id
                          row testId=`suggested-${s.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text s.name
                              text s.detail font="-exact-footnote" color="-exact-secondary-label"
                            button press=watchSuggested(s.address) disabled=(pending(addedCompany)) aria-label=`Watch ${s.name}`
                              text "Watch"
                else if e.name == "answers"
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      header
                        text "Keep an Answer"
                      row padding-top=10 padding-bottom=10
                        input value=kQuestion input=editKQuestion placeholder="The question" aria-label="The question" testId="kept-question" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        textarea value=kAnswer input=editKAnswer rows=4 placeholder="Your answer, in your own words" aria-label="Your answer" testId="kept-answer" flex=1 min-width=0
                      button press=submitKept disabled=(pending(addedKept)) testId="kept-add"
                        text "Keep Answer"
                      if keptError != ""
                        row padding-top=10 padding-bottom=10 animation=settle(still)
                          text keptError color="-exact-system-red" flex=1 min-width=0 testId="kept-error"
                      footer
                        text "JobPilot never writes an answer for you. These are only what you typed, kept so you can copy them into an application."
                    if keptList.length > 0
                      section
                        header
                          text "Kept"
                        for k in keptList key=k.id
                          row delete=dropKept(k.id) testId=`kept-${k.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text k.question testId=`kept-q-${k.id}`
                              text k.answer font="-exact-subheadline" color="-exact-secondary-label"
                              text k.updated font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                else if e.name == "settings"
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      header
                        text "Model"
                      row
                        text "Provider" flex=1
                        select value=wProvider change=editProvider aria-label="Provider" testId="set-provider"
                          option "Ollama" value="ollama"
                          option "OpenAI-compatible" value="openai"
                      row padding-top=10 padding-bottom=10
                        input type="url" value=wBase input=editBase placeholder="Base URL" aria-label="Base URL" autocapitalize="none" testId="set-base" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        input value=wModel input=editModel placeholder="Model" aria-label="Model" autocapitalize="none" testId="set-model" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        input value=wLabel input=editLabel placeholder="Key name, such as openrouter" aria-label="Key name" autocapitalize="none" testId="set-label" flex=1 min-width=0
                      row padding-top=10 padding-bottom=10
                        input type="password" value=wKey input=editKey placeholder=(settings.hasKey ? "A key is kept; type to replace it" : "API key") aria-label="API key" testId="set-key" flex=1 min-width=0
                      if notice.text != ""
                        row padding-top=10 padding-bottom=10
                          text notice.text flex=1 min-width=0 color="-exact-label" testId="set-notice"
                      if settings.model == "" and settings.baseUrl == ""
                        row padding-top=10 padding-bottom=10
                          text "No model is set up, so scouts find and filter jobs but score none." flex=1 min-width=0 color="-exact-secondary-label" testId="set-nomodel"
                      footer
                        text "The key is kept in this device’s secure storage, never in the app’s database, and is not shown again. On the web build it is kept in the browser, for development only."
                    section
                      header
                        text "Notifications"
                      row
                        text "Notify me" flex=1
                        input type="checkbox" switch checked=wNotify change=editNotify aria-label="Notify me" testId="set-notify"
                      row
                        text "Strong match from" flex=1
                        input type="number" value=wStrong input=editStrong min=1 max=100 step=5 aria-label="Strong match score" testId="set-strong"
                    section
                      header
                        text "Discovery"
                      row
                        text "Refresh on launch" flex=1
                        input type="checkbox" switch checked=wRefresh change=editRefresh aria-label="Refresh on launch" testId="set-refresh"
                    section
                      button press=submitSettings disabled=(pending(savedSettings)) testId="settings-save"
                        text "Save"
                      if settingsError != ""
                        row padding-top=10 padding-bottom=10 animation=settle(still)
                          text settingsError color="-exact-system-red" flex=1 min-width=0 testId="settings-error"
                      else if sFresh and match savedSettings { case some(r) => r.ok, case none => false }
                        row
                          text "Saved" color="-exact-secondary-label" testId="settings-saved"
                    if model.provider != ""
                      section
                        header
                          text "JobPilot on Your Computer"
                        row
                          text "Provider"
                          text model.provider testId="setting-provider"
                        row
                          text "Model"
                          text model.model testId="setting-model"
                        if model.address != ""
                          row padding-top=10 padding-bottom=10
                            column flex=1 min-width=0 gap=2
                              text "Address"
                              text model.address font="-exact-subheadline" color="-exact-secondary-label"
                else if e.name == "activity"
                  if runs.length == 0 and not pending(runs)
                    EmptyState(symbol="symbol:search", title="No Activity", message="What JobPilot does on your behalf is recorded here.")
                  else
                    list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                      section
                        for r, i in runs key=r.id
                          row testId=`run-${r.id}` animation=rise(still, i)
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text r.title testId=`run-title-${i}`
                              text `${r.events} ${r.events == 1 ? "step" : "steps"}` font="-exact-subheadline" color="-exact-secondary-label"
                            column align-items="flex-end" gap=4
                              column testId=`run-status-${r.id}`
                                Badge(label=capital(r.status), tint=runTint(r.status))
                              text r.started font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                else if e.name == "application"
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        text "Company"
                        text app.company
                      row
                        text "Status" flex=1
                        column testId="app-state" -exact-layout-transition=(still ? "none" : "260ms ease")
                          Badge(label=app.state, tint=stateTint(app.state))
                      row
                        text "Updated"
                        text app.updated font-variant-numeric="tabular-nums"
                    if app.applyUrl != ""
                      section
                        link href=app.applyUrl testId="app-apply"
                          text "Open the Application Page"
                    if app.local
                      if app.next.length > 0
                        section
                          row padding-top=10 padding-bottom=10
                            input value=reason input=noteReason placeholder="Why (optional)" aria-label="Reason for the change"
                              testId="reason" flex=1 min-width=0
                          for n in app.next key=n.code
                            button press=advance(n.code) testId=`next-${n.code}`
                              text n.label
                          if moveError != ""
                            row animation=settle(still)
                              text moveError color="-exact-system-red" testId="move-error"
                      section
                        row padding-top=10 padding-bottom=10
                          input type="url" value=linkDraft input=editLink submit=saveLink placeholder="Apply link" aria-label="Apply link"
                            testId="link" flex=1 min-width=0
                        button press=saveLink disabled=(pending(linked)) testId="save-link"
                          text "Save Link"
                        if linkError != ""
                          row animation=settle(still)
                            text linkError color="-exact-system-red" testId="link-error"
                    if steps.length > 0
                      section
                        for s in steps key=s.id
                          row testId=`step-${s.id}`
                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                              text `${s.from == "" ? "" : s.from + " → "}${s.to}`
                              if s.reason != ""
                                text s.reason font="-exact-subheadline" color="-exact-secondary-label"
                            text s.at font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                else
                  list id=`content-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        text "Company"
                        text opened.company testId="detail-company"
                      if opened.location != ""
                        row
                          text "Location"
                          text opened.location
                      if opened.remote != ""
                        row
                          text "Work"
                          text opened.remote
                      if opened.salary != ""
                        row
                          text "Salary"
                          text opened.salary testId="detail-salary"
                      row
                        text "Posted"
                        text opened.posted font-variant-numeric="tabular-nums"
                    section
                      row
                        text "Fit"
                        text scoreText testId="detail-score"
                      if fit.jobId == selected and fit.score >= 0
                        row padding-top=6 padding-bottom=10
                          progress value=fit.score max=100 aria-label="Match score" aria-valuetext=scoreText
                            flex=1 min-width=0 animation=settle(still) testId="detail-meter"
                      if fit.jobId == selected and fit.rationale != ""
                        row padding-top=10 padding-bottom=10
                          text fit.rationale flex=1 min-width=0 testId="detail-rationale"
                    if opened.skills.length > 0
                      section
                        row
                          text "Skills"
                          text opened.skills.join(", ") testId="detail-skills"
                    section
                      row padding-top=10 padding-bottom=10
                        text opened.description flex=1 min-width=0 testId="detail-description"
                    section
                      link href=opened.url testId="detail-open"
                        text "Open the Posting"
                    if jobCompany.onBoard
                      section
                        if jobCompany.watched
                          row
                            text `Watching ${jobCompany.name}` flex=1 min-width=0 testId="company-watching"
                        else
                          button press=watchThisCompany disabled=(pending(watchedJob)) testId="company-watch"
                            text "Watch This Company"
                        if watchJobError != ""
                          row animation=settle(still)
                            text watchJobError color="-exact-system-red" flex=1 min-width=0 testId="company-watch-error"
      dialog id="clear-activity" role="alertdialog" aria-label="Clear all activity?"
        text "This removes the record of every run on this device. Your applications and scouts stay."
        button press=clearNow destructive=true commandfor="clear-activity" command="close" testId="clear-confirm"
          text "Clear"
        button commandfor="clear-activity" command="close" testId="clear-cancel"
          text "Cancel"
      row role="tablist" testId="tabs"
        button role="tab" aria-controls="panel-jobs" aria-selected=(nav.tab == "jobs") press=pick("jobs")
          testId="tab-jobs" flex=1
          image "symbol:bag"
          text "Jobs"
        button role="tab" aria-controls="panel-applications" aria-selected=(nav.tab == "applications")
          press=pick("applications") testId="tab-applications" flex=1
          image "symbol:document"
          text "Applications"
        button role="tab" aria-controls="panel-discover" aria-selected=(nav.tab == "discover") press=pick("discover")
          testId="tab-discover" flex=1
          image "symbol:search"
          text "Discover"
        button role="tab" aria-controls="panel-scouts" aria-selected=(nav.tab == "scouts") press=pick("scouts")
          testId="tab-scouts" flex=1
          image "symbol:radio"
          text "Scouts"
        button role="tab" aria-controls="panel-profile" aria-selected=(nav.tab == "profile") press=pick("profile")
          testId="tab-profile" flex=1
          image "symbol:person"
          text "Profile"
