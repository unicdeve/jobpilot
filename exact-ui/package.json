{
  "name": "exact-ui",
  "private": true,
  "scripts": {
    "build": "bun exact.mjs web-build --out dist",
    "start": "bun exact.mjs serve dist",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run format:check && bun run test",
    "web": "bun exact.mjs web",
    "ios": "bun exact.mjs ios --run",
    "mac": "bun exact.mjs mac --run",
    "android": "bun exact.mjs android --run",
    "android:emulator": "emulator -avd $(emulator -list-avds | head -1)",
    "share": "bun exact.mjs share",
    "verify": "bun exact.mjs verify",
    "test:contract": "bun exact.mjs test web"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
