// `test` and `verify` start server.ts, a stand-in for the daemon's read API, empty for each test.
test "jobs list, search and a job's detail with its match"
  clock data
  expect tree has "job-j1"
  expect tree has "job-j2"
  expect tree has "job-j3"
  type "search" "designer"
  expect tree has "job-j2"
  expect tree missing "job-j1"
  type "search" ""
  tap "job-j1"
  clock data
  expect text "detail-company" == "Acme"
  expect text "detail-salary" == "EUR 90k–120k"
  expect text "detail-score" == "86% match"
  expect text "detail-rationale" == "Strong Go and SQLite background."
  expect text "detail-skills" == "Go, SQLite"

test "a job with no analysis says so"
  clock data
  tap "job-j2"
  clock data
  expect text "detail-score" == "No match analysis yet"

test "applications show where each one stands"
  clock data
  tap "tab-applications"
  clock data
  expect text "state-a1" == "Sent"
  expect text "state-a2" == "Interviewing"

test "an application shows its history and its apply page"
  clock data
  tap "tab-applications"
  clock data
  tap "application-a1"
  clock data
  expect text "app-state" == "Sent"
  expect tree has "app-apply"
  expect tree has "step-s2"

test "scouts show whether each one is on"
  clock data
  tap "tab-scouts"
  clock data
  expect text "scout-state-sc1" == "On"
  expect text "scout-state-sc2" == "Off"

test "the profile shows who the candidate is"
  clock data
  tap "tab-profile"
  clock data
  expect text "profile-name" == "Ada Lovelace"
  expect text "profile-email" == "ada@example.com"

test "resumes and activity open from the profile"
  clock data
  tap "tab-profile"
  clock data
  tap "open-resumes"
  clock data
  expect tree has "resume-r1"
  tap "tab-profile"
  tap "open-activity"
  clock data
  expect text "run-status-run1" == "completed"

test "settings show the model JobPilot uses"
  clock data
  tap "tab-profile"
  clock data
  tap "open-settings"
  clock data
  expect text "setting-provider" == "ollama"
  expect text "setting-model" == "llama3.2"

test "discovery asks every source at once, names the one that failed, and shows where each job came from"
  clock data
  tap "tab-discover"
  clock data
  type "find" "go"
  clock data
  expect tree has "found-remotive:1"
  expect tree missing "found-remotive:2"
  expect tree has "found-remoteok:77"
  expect tree has "found-arbeitnow:go-dev-berlin"
  expect text "found-source-remotive:1" == "via Remotive"
  expect text "found-source-remoteok:77" == "via RemoteOK"
  expect text "source-notice" == "Himalayas, We Work Remotely, Hacker News did not answer, so their jobs are missing."

test "a found job is tracked once, moved along the rule table, and its history kept"
  clock data
  tap "tab-discover"
  type "find" "go"
  clock data
  tap "track-remotive:1"
  clock data
  expect tree has "tracked-remotive:1"
  expect tree missing "track-remotive:1"
  tap "tab-applications"
  clock data
  expect text "state-local:remotive:1" == "Discovered"
  tap "application-local:remotive:1"
  clock data
  expect tree has "next-MATCHED"
  expect tree has "next-WITHDRAWN"
  expect tree missing "next-SUBMITTED"
  type "reason" "Fits my skills"
  tap "next-MATCHED"
  clock data
  expect text "app-state" == "Matched"
  expect tree has "step-local:remotive:1:1"
  expect tree has "next-SUBMITTED"
  expect tree missing "next-MATCHED"

test "an apply link must be a web address"
  clock data
  tap "tab-discover"
  type "find" "go"
  clock data
  tap "track-remotive:1"
  clock data
  tap "tab-applications"
  clock data
  tap "application-local:remotive:1"
  clock data
  type "link" "not a link"
  tap "save-link"
  clock data
  expect tree has "link-error"
  type "link" "https://jobs.example.com/apply"
  tap "save-link"
  clock data
  expect tree missing "link-error"
  expect tree has "app-apply"

test "a scout is created with typed keywords, and checked"
  clock data
  tap "tab-scouts"
  clock data
  tap "new-scout"
  clock data
  tap "scout-save"
  clock data
  expect text "scout-error" == "A scout needs a name."
  type "scout-name" "Go roles"
  tap "scout-save"
  clock data
  expect text "scout-error" == "Type the keywords to look for, or choose a template or a saved search."
  type "scout-keywords" "go"
  tap "scout-save"
  clock data
  expect text "scout-state-sc1" == "On"
  expect text "scout-state-scout-1" == "On"

test "running a scout with no model records that jobs could not be scored and creates no application"
  clock data
  tap "tab-scouts"
  clock data
  tap "new-scout"
  clock data
  type "scout-name" "Go roles"
  type "scout-keywords" "go"
  tap "scout-save"
  clock data
  tap "tab-scouts"
  tap "scout-scout-1"
  clock data
  tap "scout-run"
  clock data
  expect text "scout-run-result" == "3 jobs considered, 0 applications created. 3 jobs could not be scored because no model is set up to score them, so none of those became an application."
  tap "tab-applications"
  clock data
  expect tree missing "application-local:remotive:1"

test "an unreachable daemon offers Try Again, and recovers"
  fail fetch "http://127.0.0.1:4417"
  reload
  clock data
  expect tree has "retry-jobs"
  pass fetch "http://127.0.0.1:4417"
  tap "retry-jobs"
  clock data
  expect tree has "job-j1"

test "the profile is edited on the device and kept after a relaunch"
  clock data
  tap "tab-profile"
  tap "edit-profile"
  clock data
  type "p-first" "Grace"
  type "p-last" "Hopper"
  type "p-email" "grace@example.com"
  type "p-skills" "Go: 6, SQLite"
  type "p-exp" "Engineer | Acme | 2022-07 | | Payments"
  type "p-auth" "Nigeria: authorized"
  type "p-links" "github https://github.com/grace"
  tap "profile-save"
  clock data
  expect text "profile-name" == "Grace Hopper"
  expect text "profile-skills" == "Go (6 y), SQLite"
  reload
  clock data
  tap "tab-profile"
  clock data
  expect text "profile-name" == "Grace Hopper"
  expect text "profile-email" == "grace@example.com"

test "a profile line that cannot be read is refused and nothing is kept"
  clock data
  tap "tab-profile"
  tap "edit-profile"
  clock data
  type "p-first" "Grace"
  type "p-skills" "Go: lots"
  tap "profile-save"
  clock data
  expect tree has "profile-error"

test "a resume is added as text and listed"
  clock data
  tap "tab-profile"
  clock data
  tap "open-resumes"
  clock data
  expect text "resume-note" == "Resumes are kept as text or Markdown that you paste or type. Importing a PDF or Word file is not available in this app yet."
  tap "resume-add"
  clock data
  expect tree has "resume-error"
  type "resume-name" "Main"
  type "resume-text" "Go engineer"
  tap "resume-add"
  clock data
  clock settle
  expect tree missing "resume-error"
  expect text "resume-title-0" == "Main"

test "a kept answer is added by the candidate and deleted"
  clock data
  tap "tab-profile"
  clock data
  tap "open-answers"
  clock data
  type "kept-question" "Why us?"
  type "kept-answer" "I like local-first software."
  tap "kept-add"
  clock data
  expect text "kept-q-a-1767225600000-1" == "Why us?"
  tap "kept-a-1767225600000-1-delete"
  clock data
  expect tree missing "kept-q-a-1767225600000-1"

test "a company is watched, shown with its open roles, and unwatched"
  clock data
  tap "tab-profile"
  clock data
  tap "open-companies"
  clock data
  type "company-address" "https://job-boards.greenhouse.io/acme"
  tap "company-add"
  clock data
  expect text "company-name-company-1767225600000-1" == "Acme Robotics"
  tap "company-company-1767225600000-1-delete"
  clock data
  expect tree missing "company-name-company-1767225600000-1"

test "an address that is not a hiring page, or whose page is gone, is refused and nothing is watched"
  clock data
  tap "tab-profile"
  clock data
  tap "open-companies"
  clock data
  type "company-address" "https://example.com/careers"
  tap "company-add"
  clock data
  expect tree has "company-error"
  type "company-address" "https://job-boards.greenhouse.io/nowhere"
  tap "company-add"
  clock data
  expect tree has "company-error"

test "a scout run appears in Activity"
  clock data
  tap "tab-scouts"
  clock data
  tap "new-scout"
  clock data
  type "scout-name" "Go roles"
  type "scout-keywords" "go"
  tap "scout-save"
  clock data
  tap "scout-scout-1"
  clock data
  tap "scout-run"
  clock data
  tap "tab-profile"
  tap "open-activity"
  clock data
  expect text "run-title-0" == "Go roles"
  tap "clear-activity"
  tap "clear-confirm"
  clock data
  expect text "run-title-0" == "Go roles in Europe"

test "settings that would send a key unencrypted to another host are refused"
  clock data
  tap "tab-profile"
  clock data
  tap "open-settings"
  clock data
  type "set-base" "http://models.example.com/v1"
  type "set-model" "m"
  type "set-label" "work"
  type "set-key" "sk-secret"
  tap "settings-save"
  clock data
  expect tree has "settings-error"
  expect tree missing "settings-saved"
  type "set-base" "https://models.example.com/v1"
  clock data
  expect tree has "set-notice"
  type "set-label" ""
  type "set-key" ""
  tap "settings-save"
  clock data
  expect tree missing "settings-error"
  expect tree has "settings-saved"
